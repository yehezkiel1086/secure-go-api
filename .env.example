DB_NAME=job_listings
DB_USER=postgres
DB_PASSWORD=admin

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=admin

ACCESS_TOKEN_SECRET=d52ba48e86fe439a2be49a2e63e8ae05e87c3bc14861a9106edb8ef5217a75397fe0f3bc762f90e2b16ab14f33bd131e8fdfc62d9fd1bd3a33bf67565c4fa5c1
REFRESH_TOKEN_SECRET=5f1960437fe15f52550bc9ad51c40f50bd328e322c6785cf7465a31493d04c77470cb21bcb035b9791028a2c94a44837f5d314af8ab94f2dc6f650e64e2ee32f

# access token duration in mins, refresh token duration in days
ACCESS_TOKEN_DURATION=15
