# SMTP configuration (for local dev testing via Mailpit web UI http://localhost:8025, or real SMTP)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@securego.com
# To use real Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM="Secure Go API <your-account@gmail.com>"
